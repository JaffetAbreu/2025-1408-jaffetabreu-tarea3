<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane fx:controller="com.programacion.tarea3alfonso.Controller"
          xmlns:fx="http://javafx.com/fxml"
          alignment="CENTER" hgap="10" vgap="10" style="-fx-padding: 20;">

    <Label text="Valor:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="inputField" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

    <Label text="De:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <ComboBox fx:id="fromUnit" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="A:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
    <ComboBox fx:id="toUnit" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

    <Button text="Convertir" onAction="#convert" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    <Button text="Limpiar" onAction="#clear" GridPane.rowIndex="2" GridPane.columnIndex="2"/>

    <Label text="Resultado:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <TextField fx:id="resultField" editable="false" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

    <Label text="Historial:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <TextArea fx:id="historyArea" editable="false" wrapText="true" prefRowCount="5"
              GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
</GridPane>
